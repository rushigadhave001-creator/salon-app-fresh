
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model QueueItem {
  id            String   @id @default(uuid())
  tokenNumber   String
  customerName  String
  mobileNumber  String
  serviceType   String
  status        String   @default("Waiting") // Waiting, In-Chair, Completed, No-Show
  notified15Min Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id     String  @id @default("1")
  isOpen Boolean @default(true)
  pin    String  @default("1234")
}
